# ─── Database ───────────────────────────────────────────────
# Individual connection parts (also consumed by docker-compose.yml).
# Host port 5433 is mapped to the container's 5432.
DB_HOST=localhost
DB_PORT=5433
DB_USER=adminhub
DB_PASSWORD=adminhub
DB_NAME=adminhub
DB_SCHEMA=public

# Composed connection string Prisma actually reads (variable expansion).
# Local Docker/localhost needs no SSL. For a remote/managed DB enable it:
#   ...?schema=${DB_SCHEMA}&sslmode=require         (encrypt, no cert check)
#   ...?schema=${DB_SCHEMA}&sslmode=verify-full     (encrypt + verify cert)
DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=${DB_SCHEMA}"

# ─── App ────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
API_PREFIX=api

# ─── Auth / JWT ─────────────────────────────────────────────
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN_DAYS=7
BCRYPT_SALT_ROUNDS=10

# Expose Swagger UI. Auto-disabled when NODE_ENV=production unless set true.
SWAGGER_ENABLED=true

# ─── Rate limiting ──────────────────────────────────────────
# Global default (per IP / window). Login has its own stricter 5/min limit.
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ─── Seed admin credentials (used by prisma/seed.ts) ────────
SEED_ADMIN_EMAIL="admin@adminhub.com"
SEED_ADMIN_PASSWORD="Admin@12345"
