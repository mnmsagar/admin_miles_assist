# ─── Database ───────────────────────────────────────────────
# Individual connection parts — consumed by the app, the Prisma CLI wrapper
# and docker-compose.yml. The connection URL is composed from these at
# runtime, so you never set a DATABASE_URL by hand.
# Host port 5433 is mapped to the container's 5432.
DB_HOST=localhost
DB_PORT=5433
DB_USER=adminhub
DB_PASSWORD=adminhub
DB_NAME=adminhub
# SSL: true for remote/managed Postgres (adds sslmode=require), false for local.
DB_SSL=false
# Connection pooling: maximum active connections in the pool (default: 10)
DB_POOL_LIMIT=10
# Connection pool timeout in seconds (default: 10)
DB_POOL_TIMEOUT=10
# Set true if connecting via PgBouncer / external pooler
DB_PGBOUNCER=false

# ─── App ────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
API_PREFIX=api

# ─── Auth / JWT ─────────────────────────────────────────────
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN_DAYS=7
BCRYPT_SALT_ROUNDS=10

# Expose Swagger UI. Auto-disabled when NODE_ENV=production unless set true.
SWAGGER_ENABLED=true

# ─── Rate limiting ──────────────────────────────────────────
# Global default (per IP / window). Login has its own stricter 5/min limit.
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ─── Seed admin credentials (used by prisma/seed.ts) ────────
SEED_ADMIN_EMAIL="admin@adminhub.com"
SEED_ADMIN_PASSWORD="Admin@12345"
