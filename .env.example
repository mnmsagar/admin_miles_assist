# ─── Database ───────────────────────────────────────────────
# Matches docker-compose.yml (host port 5433 → container 5432)
DATABASE_URL="postgresql://adminhub:adminhub@localhost:5433/adminhub?schema=public"

# ─── App ────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
API_PREFIX=api

# ─── Auth / JWT ─────────────────────────────────────────────
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN_DAYS=7
BCRYPT_SALT_ROUNDS=10

# Expose Swagger UI. Auto-disabled when NODE_ENV=production unless set true.
SWAGGER_ENABLED=true

# ─── Rate limiting ──────────────────────────────────────────
# Global default (per IP / window). Login has its own stricter 5/min limit.
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ─── Seed admin credentials (used by prisma/seed.ts) ────────
SEED_ADMIN_EMAIL="admin@adminhub.com"
SEED_ADMIN_PASSWORD="Admin@12345"
