// AdminHub — Prisma schema
// Derived from Figma design analysis (docs/REQUIREMENTS_ANALYSIS.md)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── Enums ───────────────────────────

enum UserRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
  VIEWER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum TransactionType {
  PAYMENT
  REFUND
  TRANSFER
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PAID
  UNPAID
}

enum ServiceType {
  BUSINESS_CONSULTATION
  TECHNICAL_SUPPORT
  EXECUTIVE_COACHING
  STRATEGY_SESSION
  PERSONAL_TRAINING
  IT_CONSULTATION
  EXECUTIVE_TRAINING
  PLATFORM_AUDIT
  DATABASE_MIGRATION
  SECURITY_ASSESSMENT
}

enum AlertSeverity {
  CRITICAL
  WARNING
  INFO
  SUCCESS
}

// ─────────────────────────── Models ───────────────────────────

model User {
  id               String     @id @default(uuid())
  displayId        String     @unique // e.g. USR-4821
  fullName         String
  email            String     @unique
  passwordHash     String
  phone            String?
  dateOfBirth      DateTime?  @db.Date
  mailingAddress   String?
  role             UserRole   @default(VIEWER)
  status           UserStatus @default(ACTIVE)
  avatarUrl        String?
  twoFactorEnabled Boolean    @default(false)
  joinedAt         DateTime   @default(now())
  lastActiveAt     DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  transactions  Transaction[]
  bookings      Booking[]
  activityLogs  ActivityLog[]
  refreshTokens RefreshToken[]

  @@index([role])
  @@index([status])
  @@index([joinedAt])
  @@index([fullName])
  @@index([email])
  @@map("users")
}

model Transaction {
  id            String            @id @default(uuid())
  displayId     String            @unique // TXN-1082
  reference     String?           @unique // REF-98342718
  userId        String
  type          TransactionType
  amount        Decimal           @db.Decimal(12, 2)
  status        TransactionStatus @default(PENDING)
  paymentMethod String?
  gatewayFee    Decimal?          @db.Decimal(12, 2)
  subtotal      Decimal?          @db.Decimal(12, 2)
  grandTotal    Decimal?          @db.Decimal(12, 2)
  occurredAt    DateTime          @default(now())
  settledAt     DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  events  TransactionEvent[]
  booking Booking?

  @@index([userId])
  @@index([status])
  @@index([type])
  @@index([occurredAt])
  @@index([amount])
  @@map("transactions")
}

model TransactionEvent {
  id            String   @id @default(uuid())
  transactionId String
  label         String // "Completed & Disbursed"
  description   String?
  occurredAt    DateTime @default(now())
  createdAt     DateTime @default(now())

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@map("transaction_events")
}

model Booking {
  id              String        @id @default(uuid())
  displayId       String        @unique // BKG-2341
  userId          String
  serviceType     ServiceType
  scheduledAt     DateTime
  durationMinutes Int           @default(60)
  status          BookingStatus @default(PENDING)
  amount          Decimal       @db.Decimal(12, 2)
  location        String?
  meetingTimeSlot String?
  clientNotes     String?
  paymentStatus   PaymentStatus @default(UNPAID)
  invoiceRef      String?       @unique // INV-10294
  transactionId   String?       @unique
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction Transaction?   @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  events      BookingEvent[]

  @@index([userId])
  @@index([status])
  @@index([serviceType])
  @@index([scheduledAt])
  @@index([paymentStatus])
  @@map("bookings")
}

model BookingEvent {
  id          String   @id @default(uuid())
  bookingId   String
  label       String // "Status Set to Confirmed"
  description String?
  occurredAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("booking_events")
}

model ActivityLog {
  id          String   @id @default(uuid())
  userId      String
  title       String // "Created booking #BKG-2341"
  description String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("activity_logs")
}

model Alert {
  id          String        @id @default(uuid())
  title       String // "Server capacity at 92%"
  description String? // "Scale resources"
  severity    AlertSeverity @default(INFO)
  isRead      Boolean       @default(false)
  createdAt   DateTime      @default(now())

  @@index([severity])
  @@index([createdAt])
  @@map("alerts")
}

// Rotating refresh tokens — opaque tokens stored as a SHA-256 hash so they
// can be revoked server-side. One row per issued token (rotated on use).
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// System telemetry snapshot (Uptime / Response time / Active sessions).
// Seeded so dashboard health values come from PostgreSQL.
model SystemHealthSnapshot {
  id                 String   @id @default(uuid())
  uptimePercent      Decimal  @db.Decimal(5, 2) // 99.80
  avgResponseTimeMs  Int // 142
  activeSessions     Int // 3241
  capturedAt         DateTime @default(now())

  @@index([capturedAt])
  @@map("system_health_snapshots")
}
