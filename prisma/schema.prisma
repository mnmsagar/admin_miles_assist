// AdminHub — Prisma schema
// Two distinct populations:
//   - AdminUser : operators of the admin portal (authenticate here, have roles)
//   - Customer  : end-users of the public website (subjects of transactions/bookings)
// See docs/REQUIREMENTS_ANALYSIS.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Prisma CLI requires a URL here. It is composed from the DB_* vars by
  // scripts/with-db-url.ts (see package.json prisma:* scripts), so DATABASE_URL
  // is never stored in .env. The app builds the same URL in PrismaService.
  url      = env("DATABASE_URL")
}

// ─────────────────────────── Enums ───────────────────────────

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
  VIEWER
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum TransactionType {
  PAYMENT
  REFUND
  TRANSFER
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PAID
  UNPAID
}

enum ServiceType {
  BUSINESS_CONSULTATION
  TECHNICAL_SUPPORT
  EXECUTIVE_COACHING
  STRATEGY_SESSION
  PERSONAL_TRAINING
  IT_CONSULTATION
  EXECUTIVE_TRAINING
  PLATFORM_AUDIT
  DATABASE_MIGRATION
  SECURITY_ASSESSMENT
}

enum AlertSeverity {
  CRITICAL
  WARNING
  INFO
  SUCCESS
}

// ─────────────────────────── Models ───────────────────────────

// Admin-portal operators. Authentication + RBAC live here.
model AdminUser {
  id               String        @id @default(uuid())
  displayId        String        @unique // ADM-0001
  fullName         String
  email            String        @unique
  passwordHash     String
  phone            String?
  role             AdminRole     @default(VIEWER)
  status           AccountStatus @default(ACTIVE)
  avatarUrl        String?
  twoFactorEnabled Boolean       @default(false)
  joinedAt         DateTime      @default(now())
  lastActiveAt     DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  refreshTokens RefreshToken[]

  @@index([role])
  @@index([status])
  @@index([joinedAt])
  @@index([fullName])
  @@index([email])
  @@map("admin_users")
}

// Website end-users. Managed/viewed from the admin portal. No portal login here.
model User {
  id               String        @id @default(uuid())
  displayId        String        @unique // USR-4821
  fullName         String
  email            String        @unique
  phone            String?
  dateOfBirth      DateTime?     @db.Date
  mailingAddress   String?
  role             AdminRole     @default(VIEWER)
  status           AccountStatus @default(ACTIVE)
  avatarUrl        String?
  twoFactorEnabled Boolean       @default(false)
  joinedAt         DateTime      @default(now())
  lastActiveAt     DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  transactions Transaction[]
  bookings     Booking[]
  activityLogs ActivityLog[]

  @@index([role])
  @@index([status])
  @@index([joinedAt])
  @@index([fullName])
  @@index([email])
  @@map("users")
}

model Transaction {
  id            String            @id @default(uuid())
  displayId     String            @unique // TXN-1082
  reference     String?           @unique // REF-98342718
  userId        String
  type          TransactionType
  amount        Decimal           @db.Decimal(12, 2)
  status        TransactionStatus @default(PENDING)
  paymentMethod String?
  gatewayFee    Decimal?          @db.Decimal(12, 2)
  subtotal      Decimal?          @db.Decimal(12, 2)
  grandTotal    Decimal?          @db.Decimal(12, 2)
  occurredAt    DateTime          @default(now())
  settledAt     DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  events  TransactionEvent[]
  booking Booking?

  @@index([userId])
  @@index([status])
  @@index([type])
  @@index([occurredAt])
  @@index([amount])
  @@map("transactions")
}

model TransactionEvent {
  id            String   @id @default(uuid())
  transactionId String
  label         String
  description   String?
  occurredAt    DateTime @default(now())
  createdAt     DateTime @default(now())

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@map("transaction_events")
}

model Booking {
  id              String        @id @default(uuid())
  displayId       String        @unique // BKG-2341
  userId          String
  serviceType     ServiceType
  scheduledAt     DateTime
  durationMinutes Int           @default(60)
  status          BookingStatus @default(PENDING)
  amount          Decimal       @db.Decimal(12, 2)
  location        String?
  meetingTimeSlot String?
  clientNotes     String?
  paymentStatus   PaymentStatus @default(UNPAID)
  invoiceRef      String?       @unique // INV-10294
  transactionId   String?       @unique
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction Transaction?   @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  events      BookingEvent[]

  @@index([userId])
  @@index([status])
  @@index([serviceType])
  @@index([scheduledAt])
  @@index([paymentStatus])
  @@map("bookings")
}

model BookingEvent {
  id          String   @id @default(uuid())
  bookingId   String
  label       String
  description String?
  occurredAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("booking_events")
}

model ActivityLog {
  id          String   @id @default(uuid())
  userId      String
  title       String
  description String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("activity_logs")
}

model Alert {
  id          String        @id @default(uuid())
  title       String
  description String?
  severity    AlertSeverity @default(INFO)
  isRead      Boolean       @default(false)
  createdAt   DateTime      @default(now())

  @@index([severity])
  @@index([createdAt])
  @@map("alerts")
}

// Rotating refresh tokens for admin-portal sessions (SHA-256 hashed, revocable).
model RefreshToken {
  id          String    @id @default(uuid())
  adminUserId String
  tokenHash   String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@map("refresh_tokens")
}

model SystemHealthSnapshot {
  id                String   @id @default(uuid())
  uptimePercent     Decimal  @db.Decimal(5, 2)
  avgResponseTimeMs Int
  activeSessions    Int
  capturedAt        DateTime @default(now())

  @@index([capturedAt])
  @@map("system_health_snapshots")
}
